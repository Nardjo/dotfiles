<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirkobozzetto.herdr-update</string>

  <!-- Upgrades the binary only. The running server keeps the old code in
       memory until it is restarted, so this never interrupts live panes. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/brew</string>
    <string>upgrade</string>
    <string>herdr</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOMEBREW_NO_AUTO_UPDATE</key>
    <string>0</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <!-- the machine is often asleep at 09:30; run as soon as it wakes -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/mirkobozzetto/Library/Logs/herdr-update.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mirkobozzetto/Library/Logs/herdr-update.log</string>
</dict>
</plist>
