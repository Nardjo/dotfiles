# Single config. The one in Application Support is emptied out: Ghostty was
# loading both and the second one silently won.

# two themes: Ghostty follows the macOS appearance and, through mode 2031,
# tells tmux and Neovim to switch with it.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
font-family = MesloLGL Nerd Font
font-size = 16
font-feature = calt
font-feature = liga
# left only: right Option keeps macOS composition, otherwise AZERTY dead
# keys die and ~ { } | \ become untypable
macos-option-as-alt = left
mouse-scroll-multiplier = 1

# official | blueprint | chalkboard | microchip | glass | holographic |
# paper | retro | xray | custom | custom-style
macos-icon = xray
# shell integration sets a ghost emoji as the window title: this drops that
# one feature and keeps the rest (cursor, sudo, cwd reporting)
shell-integration-features = no-title
# macos-custom-icon = ~/.config/ghostty/catppuccin-mocha.icns
scrollback-limit = 10000
background-blur = false
background-opacity = 1

# kitty-style animated cursor: the shader needs the block cursor,
# and to keep running continuously or it freezes when the window loses focus
cursor-style = block
custom-shader = shaders/cursor_tail.glsl
# false: the shader only receives frames when the screen changes, so nothing at rest
custom-shader-animation = false

confirm-close-surface = true
window-save-state = always

# via a login shell: otherwise the server inherits macOS apps' minimal PATH
command = /bin/zsh -lc "exec /Users/jordanbastin/.config/mux"

# Prefix is Ctrl+B (\x02), not Ctrl+Space. Grok Build uses Ctrl+Space for voice.
# Cmd shortcuts send the prefix for you; you never type it.
keybind = cmd+d=text:\x02|
keybind = cmd+shift+h=text:\x02\x5c
keybind = cmd+shift+d=text:\x02-
keybind = cmd+shift+z=text:\x02z
keybind = cmd+shift+w=text:\x02x
keybind = cmd+t=text:\x02c
keybind = cmd+p=text:\x02o
keybind = cmd+o=text:\x02O
keybind = cmd+shift+b=text:\x02e
keybind = cmd+shift+g=text:\x02g
keybind = cmd+shift+p=text:\x02s
keybind = cmd+shift+left=text:\x02p
keybind = cmd+shift+right=text:\x02n
keybind = ctrl+tab=text:\x02n
keybind = ctrl+shift+tab=text:\x02p
keybind = alt+tab=text:\x02)
keybind = alt+shift+tab=text:\x02(
keybind = alt+grave_accent=text:\x02\x7f
keybind = cmd+alt+left=text:\x02h
keybind = cmd+alt+right=text:\x02l
keybind = cmd+alt+up=text:\x02k
keybind = cmd+alt+down=text:\x02j
keybind = cmd+ctrl+left=text:\x02H
keybind = cmd+ctrl+right=text:\x02L
keybind = cmd+ctrl+up=text:\x02K
keybind = cmd+ctrl+down=text:\x02J
keybind = cmd+alt+one=text:\x021
keybind = cmd+alt+two=text:\x022
keybind = cmd+alt+three=text:\x023
keybind = cmd+alt+four=text:\x024
keybind = cmd+alt+five=text:\x025

# Grok: Cmd+A selects the prompt; Shift+Enter is a newline in the composer
keybind = cmd+a=unbind
keybind = shift+enter=text:\n

keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = cmd+backspace=text:\x15
